+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_type_of(&var), AMXC_VAR_ID_CSTRING);
+    assert_string_equal(amxc_var_constcast(cstring_t, &var), "hello");
+    free(value.data.s);
+
+    amxd_param_value_init(&value);
+    value.type_id = AMXC_VAR_ID_CSTRING;
+    value.data.s = NULL;
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_string_equal(amxc_var_constcast(cstring_t, &var), "");
+
+    amxd_param_value_init(&value);
+    value.type_id = AMXC_VAR_ID_CSV_STRING;
+    value.data.s = strdup("a,b,c");
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_type_of(&var), AMXC_VAR_ID_CSV_STRING);
+    free(value.data.s);
+
+    amxd_param_value_init(&value);
+    value.type_id = AMXC_VAR_ID_SSV_STRING;
+    value.data.s = strdup("a b c");
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_type_of(&var), AMXC_VAR_ID_SSV_STRING);
+    free(value.data.s);
+
+    amxc_var_clean(&var);
+}
