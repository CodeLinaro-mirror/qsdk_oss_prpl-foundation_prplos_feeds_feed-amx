+#endif
+
+typedef struct _amxd_param_value amxd_param_value_t;
+
+struct _amxd_param_value {
+    amxc_var_type_id_t type_id; // parameter data type
+    union
+    {
+        char* s;                // string
+        int8_t i8;              // 8 bit signed integer
+        int16_t i16;            // 16 bit signed integer
+        int32_t i32;            // 32 bit signed integer
+        int64_t i64;            // 64 bit signed integer
+        uint8_t ui8;            // 8 bit unsigned integer
+        uint16_t ui16;          // 16 bit unsigned integer
+        uint32_t ui32;          // 32 bit unsigned integer
+        uint64_t ui64;          // 64 bit unsigned integer
+        float f;                // float
+        double d;               // double
+        bool b;                 // boolean
+        amxc_ts_t ts;           // timestamp
+    } data;                     // parameter data
+};
+
+PRIVATE
+int amxd_param_value_init(amxd_param_value_t* value);
+
+PRIVATE
+void amxd_param_value_clean(amxd_param_value_t* value);
+
+PRIVATE
+int amxd_param_value_set_type(amxd_param_value_t* value, amxc_var_type_id_t type);
+
+PRIVATE
+amxc_var_type_id_t amxd_param_value_type_of(const amxd_param_value_t* const value);
+
+PRIVATE
+int amxd_param_value_to_variant(const amxd_param_value_t* const value, amxc_var_t* var);
+
+PRIVATE
+int amxd_param_value_from_variant(amxd_param_value_t* value, amxc_var_t* var);
+
+PRIVATE
+int amxd_param_value_copy(amxd_param_value_t* const dest, const amxd_param_value_t* const src);
+
+PRIVATE
+int amxd_param_value_compare_variant(const amxd_param_value_t* const value,
+                                     const amxc_var_t* const var,
+                                     int* result);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // __AMXD_PARAM_VALUE_PRIV_H__
