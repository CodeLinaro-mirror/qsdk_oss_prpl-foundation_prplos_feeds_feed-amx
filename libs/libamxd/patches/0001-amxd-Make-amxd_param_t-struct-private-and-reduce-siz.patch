+void test_amxd_param_value_init(UNUSED void** state) {
+    amxd_param_value_t value;
+
+    assert_int_equal(amxd_param_value_init(&value), 0);
+    assert_int_equal(value.type_id, 0);
+    assert_null(value.data.s);
+}
+
+void test_amxd_param_value_init_null(UNUSED void** state) {
+    assert_int_not_equal(amxd_param_value_init(NULL), 0);
+}
+
+void test_amxd_param_value_clean_null(UNUSED void** state) {
+    amxd_param_value_clean(NULL);
+}
+
+void test_amxd_param_value_clean_string_types(UNUSED void** state) {
+    amxd_param_value_t value;
+
+    amxd_param_value_init(&value);
+    value.type_id = AMXC_VAR_ID_CSTRING;
+    value.data.s = strdup("hello");
+    amxd_param_value_clean(&value);
+    assert_int_equal(value.type_id, 0);
+
+    amxd_param_value_init(&value);
+    value.type_id = AMXC_VAR_ID_CSV_STRING;
+    value.data.s = strdup("a,b,c");
+    amxd_param_value_clean(&value);
+    assert_int_equal(value.type_id, 0);
+
+    amxd_param_value_init(&value);
+    value.type_id = AMXC_VAR_ID_SSV_STRING;
+    value.data.s = strdup("a b c");
+    amxd_param_value_clean(&value);
+    assert_int_equal(value.type_id, 0);
+}
+
+void test_amxd_param_value_clean_non_string(UNUSED void** state) {
+    amxd_param_value_t value;
+
+    amxd_param_value_init(&value);
+    value.type_id = AMXC_VAR_ID_INT32;
+    value.data.i32 = 42;
+    amxd_param_value_clean(&value);
+    assert_int_equal(value.type_id, 0);
+}
+
+void test_amxd_param_value_set_type(UNUSED void** state) {
+    amxd_param_value_t value;
+
+    amxd_param_value_init(&value);
+    assert_int_equal(amxd_param_value_set_type(&value, AMXC_VAR_ID_INT32), 0);
+    assert_int_equal(value.type_id, AMXC_VAR_ID_INT32);
+}
+
+void test_amxd_param_value_set_type_ts(UNUSED void** state) {
+    amxd_param_value_t value;
+    char str_ts[40];
+    const char* ts = "0001-01-01T00:00:00Z";
+
+    amxd_param_value_init(&value);
+    assert_int_equal(amxd_param_value_set_type(&value, AMXC_VAR_ID_TIMESTAMP), 0);
+    assert_int_equal(value.type_id, AMXC_VAR_ID_TIMESTAMP);
+
+    assert_int_equal(amxc_ts_format(&value.data.ts, str_ts, 40), strlen(ts));
+    assert_string_equal(str_ts, ts);
+}
+
+void test_amxd_param_value_set_type_null(UNUSED void** state) {
+    assert_int_not_equal(amxd_param_value_set_type(NULL, AMXC_VAR_ID_INT32), 0);
+}
