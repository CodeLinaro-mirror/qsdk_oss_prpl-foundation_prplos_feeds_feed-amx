+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <amxc/amxc.h>
+#include <amxp/amxp.h>
+#include <amxd/amxd_common.h>
+
+#include "amxd_priv.h"
+#include "amxd_assert.h"
+
+int amxd_param_value_init(amxd_param_value_t* value) {
+    int retval = -1;
+    when_null(value, exit);
+
+    value->type_id = 0;
+    memset(&value->data, 0, sizeof(value->data));
+    retval = 0;
+
+exit:
+    return retval;
+}
+
+void amxd_param_value_clean(amxd_param_value_t* value) {
+    when_null(value, exit);
+
+    if((value->type_id == AMXC_VAR_ID_CSTRING) ||
+       (value->type_id == AMXC_VAR_ID_CSV_STRING) ||
+       (value->type_id == AMXC_VAR_ID_SSV_STRING)) {
+        free(value->data.s);
+    }
+
+    value->type_id = 0;
+    memset(&value->data, 0, sizeof(value->data));
+
+exit:
+    return;
+}
+
+int amxd_param_value_set_type(amxd_param_value_t* value, amxc_var_type_id_t type) {
+    int retval = -1;
+    when_null(value, exit);
+
+    amxd_param_value_clean(value);
+    value->type_id = type;
+    retval = 0;
+
+    // Keep the behavior consistent with amxc_var_set_type in case of a timestamp
+    if(type == AMXC_VAR_ID_TIMESTAMP) {
+        retval = amxc_ts_parse(&value->data.ts, "0001-01-01T00:00:00Z", 20);
+    }
+
+exit:
+    return retval;
+}
+
+amxc_var_type_id_t amxd_param_value_type_of(const amxd_param_value_t* const value) {
+    return value == NULL ? AMXC_VAR_ID_NULL : value->type_id;
+}
+
+int amxd_param_value_to_variant(const amxd_param_value_t* const value, amxc_var_t* var) {
+    int retval = -1;
+    when_null(value, exit);
+    when_null(var, exit);
+
+    switch(value->type_id) {
+    case AMXC_VAR_ID_NULL:
+        retval = amxc_var_set_type(var, AMXC_VAR_ID_NULL);
+        break;
+    case AMXC_VAR_ID_CSTRING:
+        retval = amxc_var_set_cstring_t(var, value->data.s == NULL ? "" : value->data.s);
+        break;
+    case AMXC_VAR_ID_CSV_STRING:
+        retval = amxc_var_set_csv_string_t(var, value->data.s == NULL ? "" : value->data.s);
+        break;
+    case AMXC_VAR_ID_SSV_STRING:
+        retval = amxc_var_set_ssv_string_t(var, value->data.s == NULL ? "" : value->data.s);
+        break;
+    case AMXC_VAR_ID_INT8:
+        retval = amxc_var_set_int8_t(var, value->data.i8);
+        break;
+    case AMXC_VAR_ID_INT16:
+        retval = amxc_var_set_int16_t(var, value->data.i16);
+        break;
+    case AMXC_VAR_ID_INT32:
+        retval = amxc_var_set_int32_t(var, value->data.i32);
+        break;
+    case AMXC_VAR_ID_INT64:
+        retval = amxc_var_set_int64_t(var, value->data.i64);
+        break;
+    case AMXC_VAR_ID_UINT8:
+        retval = amxc_var_set_uint8_t(var, value->data.ui8);
+        break;
+    case AMXC_VAR_ID_UINT16:
+        retval = amxc_var_set_uint16_t(var, value->data.ui16);
+        break;
+    case AMXC_VAR_ID_UINT32:
+        retval = amxc_var_set_uint32_t(var, value->data.ui32);
+        break;
+    case AMXC_VAR_ID_UINT64:
+        retval = amxc_var_set_uint64_t(var, value->data.ui64);
+        break;
+    case AMXC_VAR_ID_FLOAT:
+        retval = amxc_var_set_float(var, value->data.f);
+        break;
+    case AMXC_VAR_ID_DOUBLE:
+        retval = amxc_var_set_double(var, value->data.d);
+        break;
+    case AMXC_VAR_ID_BOOL:
+        retval = amxc_var_set_bool(var, value->data.b);
+        break;
+    case AMXC_VAR_ID_TIMESTAMP:
+        retval = amxc_var_set_amxc_ts_t(var, &value->data.ts);
+        break;
+    default:
+        break;
+    }
+
+exit:
+    return retval;
+}
+
+int amxd_param_value_from_variant(amxd_param_value_t* value, amxc_var_t* var) {
+    int retval = -1;
+    when_null(value, exit);
+    when_null(var, exit);
+
+    amxd_param_value_set_type(value, amxc_var_type_of(var));
+    retval = 0;
+
+    switch(amxc_var_type_of(var)) {
+    case AMXC_VAR_ID_NULL:
+        break;
+    case AMXC_VAR_ID_CSTRING:
+    case AMXC_VAR_ID_CSV_STRING:
+    case AMXC_VAR_ID_SSV_STRING:
+        if(var->data.s != NULL) {
+            value->data.s = strdup(var->data.s);
+            if(value->data.s == NULL) {
+                amxd_param_value_clean(value);
+                retval = -1;
+                goto exit;
+            }
+        } else {
+            value->data.s = NULL;
+        }
+        break;
+    case AMXC_VAR_ID_INT8:
+        value->data.i8 = var->data.i8;
+        break;
+    case AMXC_VAR_ID_INT16:
+        value->data.i16 = var->data.i16;
+        break;
+    case AMXC_VAR_ID_INT32:
+        value->data.i32 = var->data.i32;
+        break;
+    case AMXC_VAR_ID_INT64:
+        value->data.i64 = var->data.i64;
+        break;
+    case AMXC_VAR_ID_UINT8:
+        value->data.ui8 = var->data.ui8;
+        break;
+    case AMXC_VAR_ID_UINT16:
+        value->data.ui16 = var->data.ui16;
+        break;
+    case AMXC_VAR_ID_UINT32:
+        value->data.ui32 = var->data.ui32;
+        break;
+    case AMXC_VAR_ID_UINT64:
+        value->data.ui64 = var->data.ui64;
+        break;
+    case AMXC_VAR_ID_FLOAT:
+        value->data.f = var->data.f;
+        break;
+    case AMXC_VAR_ID_DOUBLE:
+        value->data.d = var->data.d;
+        break;
+    case AMXC_VAR_ID_BOOL:
+        value->data.b = var->data.b;
+        break;
+    case AMXC_VAR_ID_TIMESTAMP:
+        value->data.ts.nsec = var->data.ts.nsec;
+        value->data.ts.sec = var->data.ts.sec;
+        value->data.ts.offset = var->data.ts.offset;
+        break;
+    default:
+        amxd_param_value_clean(value);
+        retval = -1;
+        break;
+    }
+
+exit:
+    return retval;
+}
+
+int amxd_param_value_copy(amxd_param_value_t* const dest, const amxd_param_value_t* const src) {
+    int retval = -1;
+    when_null(dest, exit);
+    when_null(src, exit);
+
+    amxd_param_value_set_type(dest, src->type_id);
+
+    if((src->type_id == AMXC_VAR_ID_CSTRING) ||
+       (src->type_id == AMXC_VAR_ID_CSV_STRING) ||
+       (src->type_id == AMXC_VAR_ID_SSV_STRING)) {
+        if(src->data.s != NULL) {
+            dest->data.s = strdup(src->data.s);
+            if(dest->data.s == NULL) {
+                amxd_param_value_clean(dest);
+                goto exit;
+            }
+        }
+    } else {
+        memcpy(&dest->data, &src->data, sizeof(src->data));
+    }
+
+    retval = 0;
+
+exit:
+    return retval;
+}
+
+int amxd_param_value_compare_variant(const amxd_param_value_t* const value,
+                                     const amxc_var_t* const var,
+                                     int* result) {
+    amxc_var_t tmp;
+    int retval = -1;
+
+    amxc_var_init(&tmp);
+    when_null(result, exit);
+
+    *result = 0;
+
+    if((value == NULL) && amxc_var_is_null(var)) {
+        retval = 0;
+        goto exit;
+    }
+
+    amxd_param_value_to_variant(value, &tmp); // Tmp will be a null variant in case value is NULL
+    retval = amxc_var_compare(&tmp, var, result);
+
+exit:
+    amxc_var_clean(&tmp);
+    return retval;
+}
