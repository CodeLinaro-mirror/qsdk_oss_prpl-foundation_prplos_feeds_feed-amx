+
+/**
+ * @brief Major version number of the lib_amxd API
+ *
+ * This macro defines the major version of the lib_amxd API. It is incremented
+ * when backwards-incompatible changes are made to the API.
+ *
+ * Applications can use this macro to conditionally compile code based on the
+ * API version, allowing them to maintain compatibility with both old and new
+ * versions of the library.
+ *
+ * @par Example:
+ * @code
+ * #if !defined(AMXD_API_MAJOR_VERSION) || AMXD_API_MAJOR_VERSION <= 6
+ *     // Use old API
+ *     amxd_old_function();
+ * #else
+ *     // Use new API (version 7+)
+ *     amxd_new_function();
+ * #endif
+ * @endcode
+ *
+ * @note The check for !defined() ensures compatibility when compiling against
+ *       older versions of lib_amxd that do not define this macro.
+ */
+#define AMXD_API_MAJOR_VERSION 7
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // __AMXD_API_VERSION_H__
