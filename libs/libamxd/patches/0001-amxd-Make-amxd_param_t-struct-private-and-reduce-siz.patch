+void test_amxd_param_value_to_variant_integers(UNUSED void** state) {
+    amxd_param_value_t value;
+    amxc_var_t var;
+
+    amxc_var_init(&var);
+    amxd_param_value_init(&value);
+
+    value.type_id = AMXC_VAR_ID_INT8;
+    value.data.i8 = -10;
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_constcast(int8_t, &var), -10);
+
+    value.type_id = AMXC_VAR_ID_INT16;
+    value.data.i16 = -1000;
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_constcast(int16_t, &var), -1000);
+
+    value.type_id = AMXC_VAR_ID_INT32;
+    value.data.i32 = -100000;
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_constcast(int32_t, &var), -100000);
+
+    value.type_id = AMXC_VAR_ID_INT64;
+    value.data.i64 = -1000000000LL;
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_constcast(int64_t, &var), -1000000000LL);
+
+    value.type_id = AMXC_VAR_ID_UINT8;
+    value.data.ui8 = 200;
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_constcast(uint8_t, &var), 200);
+
+    value.type_id = AMXC_VAR_ID_UINT16;
+    value.data.ui16 = 60000;
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_constcast(uint16_t, &var), 60000);
+
+    value.type_id = AMXC_VAR_ID_UINT32;
+    value.data.ui32 = 3000000000UL;
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_constcast(uint32_t, &var), 3000000000UL);
+
+    value.type_id = AMXC_VAR_ID_UINT64;
+    value.data.ui64 = 10000000000ULL;
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_int_equal(amxc_var_constcast(uint64_t, &var), 10000000000ULL);
+
+    amxc_var_clean(&var);
+}
+
+void test_amxd_param_value_to_variant_floats(UNUSED void** state) {
+    amxd_param_value_t value;
+    amxc_var_t var;
+
+    amxc_var_init(&var);
+    amxd_param_value_init(&value);
+
+    value.type_id = AMXC_VAR_ID_FLOAT;
+    value.data.f = 1.5f;
+    assert_int_equal(amxd_param_value_to_variant(&value, &var), 0);
+    assert_float_equal(amxc_var_constcast(float, &var), 1.5f, 0.001f);
+
